# Public, non-secret configuration only.
# 1. cp .env.example .env.local
# 2. Point VITE_API_URL at your running FastAPI backend
# 3. Start FastAPI (uvicorn main:app --reload)
# 4. Start the frontend (npm run dev)

VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false

# Never add SARVAM_API_KEY, GEMINI_API_KEY or QDRANT_API_KEY here.
# All provider secrets live server-side in FastAPI.
